FROM rust:1.90 AS builder

WORKDIR /app

# Copy everything first
COPY . .

# Install build-time dependencies
RUN apt-get update && apt-get install -y pkg-config libssl-dev build-essential

# Navigate to the server folder and build
WORKDIR /app/server
RUN cargo build --release

# --- Runtime Stage ---
FROM debian:bookworm-slim

# You need libssl3 and ca-certificates at runtime for Rust binaries using OpenSSL
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app


COPY --from=builder /app/target/release/server /app/server

# Create directories for your bind volumes
RUN mkdir -p /app/files/chat_data
RUN mkdir -p /app/files/server_data/config

CMD ["./server"]
